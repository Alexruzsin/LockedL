{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$roomCode": {
        "members": {
          ".read": "auth != null",
          "member1": {
            ".write": "auth != null && (!data.exists() || data.val() === auth.uid)",
            ".validate": "newData.val() === auth.uid"
          },
          "member2": {
            ".write": "auth != null && (!data.exists() || data.val() === auth.uid)",
            ".validate": "newData.val() === auth.uid"
          }
        },
        "canvas": {
          ".read": "auth != null && (root.child('rooms/' + $roomCode + '/members/member1').val() === auth.uid || root.child('rooms/' + $roomCode + '/members/member2').val() === auth.uid)",
          ".write": "auth != null && (root.child('rooms/' + $roomCode + '/members/member1').val() === auth.uid || root.child('rooms/' + $roomCode + '/members/member2').val() === auth.uid)"
        },
        "latestLockScreen": {
          ".read": "auth != null && (root.child('rooms/' + $roomCode + '/members/member1').val() === auth.uid || root.child('rooms/' + $roomCode + '/members/member2').val() === auth.uid)",
          ".write": "auth != null && (root.child('rooms/' + $roomCode + '/members/member1').val() === auth.uid || root.child('rooms/' + $roomCode + '/members/member2').val() === auth.uid)"
        }
      }
    }
  }
}
